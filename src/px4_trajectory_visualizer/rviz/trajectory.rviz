Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_common/Group
      Displays: []
      Name: Global Options
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Value: true
      Plane Cell Count: 20
      Normal Cell Count: 0
      Cell Size: 1
      Line Style: Lines
      Color: 100; 100; 100
      Alpha: 0.5
      Plane: XY
      Offset:
        X: 0
        Y: 0
        Z: 0
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/TF
      Name: TF
      Value: true
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Marker Scale: 0.5
      Update Interval: 0
      Frame Timeout: 15
    - Class: rviz_default_plugins/Path
      Name: TrajectoryPath
      Value: true
      Topic:
        Value: /trajectory/path
        Depth: 5
        Reliability Policy: Reliable
      Color: 0; 255; 0
      Alpha: 1
      Buffer Length: 1
      Line Style: Lines
      Line Width: 0.03
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Style: None
    - Class: rviz_default_plugins/Marker
      Name: CurrentPosition
      Value: true
      Topic:
        Value: /visualization/current_pos
        Depth: 5
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Marker
      Name: Setpoint
      Value: true
      Topic:
        Value: /visualization/setpoint
        Depth: 5
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Marker
      Name: Waypoint
      Value: true
      Topic:
        Value: /visualization/waypoint
        Depth: 5
        Reliability Policy: Reliable
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Yaw: 0.96
      Pitch: 0.8
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
      Invert Z Axis: false
